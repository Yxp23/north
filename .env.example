# Copy to .env.local and fill in. .env.local is never committed.
# Server-only values must NOT start with NEXT_PUBLIC_.

# "sandbox" or "live"
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client ID as above; the browser needs it for the PayPal popup.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# From the sandbox app's webhook settings (needed from Friday)
PAYPAL_WEBHOOK_ID=

CHANNEL3_API_KEY=
ANTHROPIC_API_KEY=

# Supabase (server-only; never prefix these with NEXT_PUBLIC_).
# Dashboard > Settings > API Keys: the "secret" key (starts with sb_secret_). Project URL: the Connect dialog.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional: which user's money the app shows. Default is one fixed demo user.
NORTH_USER_ID=

# Demo tools (pretend clock, "Start over"). On in dev. Set to 1 to keep them on in a deployed demo.
DEMO_MODE=
# The user's time zone for "late at night" and "this week". Default America/New_York.
DEMO_TIME_ZONE=
# Set to "demo" to use only the 14 curated demo products (no live Channel3 products). Use it when recording the video:
# live products can show real brand names and logos in their pictures, and the contest bans those.
STORE_MODE=
# Lets the scheduled price check (Vercel cron) call GET /api/watch/run with "Authorization: Bearer <this>". Unset = that check is off.
CRON_SECRET=
