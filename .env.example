# Copy to .env.local and fill in. .env.local is never committed.
# Server-only values must NOT start with NEXT_PUBLIC_.

# "sandbox" or "live"
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client ID as above; the browser needs it for the PayPal popup.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# From the sandbox app's webhook settings (needed from Friday)
PAYPAL_WEBHOOK_ID=

CHANNEL3_API_KEY=
ANTHROPIC_API_KEY=

# Supabase (server-only; never prefix these with NEXT_PUBLIC_).
# Dashboard > Settings > API Keys: the "secret" key (starts with sb_secret_). Project URL: the Connect dialog.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Needed to log people in (server-only, never NEXT_PUBLIC_). Dashboard > Settings > API Keys: the "publishable" key (sb_publishable_...).
# Required in production. In development it falls back to the secret key if this is empty.
SUPABASE_PUBLISHABLE_KEY=

# ---- Security (see docs/security.md) ----
# REQUIRED IN PRODUCTION. At least 32 random characters, for example:  openssl rand -base64 48
# It signs Guardian approvals, the tamper-evident audit log and login sessions. Keep it server-only. Changing it logs everyone out
# and makes older audit entries fail `npm run audit:verify`, so pick it once.
NORTH_SECRET=
# The public address of the deployed site, for example https://north.example. Login and CSRF checks accept this origin, and PayPal
# sends people back to it. Set it in production.
NORTH_SITE_URL=

# Demo tools (pretend hour, "Start over", the ledger peek, pretend tests). ON while developing. In production they are OFF unless BOTH
# DEMO_MODE=1 and DEMO_DEPLOYMENT=1 are set (the judges' demo), and then only the practice account (DEMO_USER_ID) can use them.
DEMO_MODE=
DEMO_DEPLOYMENT=
# The practice account. `node --env-file=.env.local scripts/seed-demo-user.mjs` creates it in Supabase Auth with this login.
# The login page shows these (only in a deployed demo). Practice money only.
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
DEMO_LOGIN_EMAIL=judge@north-demo.app
DEMO_LOGIN_PASSWORD=North-Judges-2026!
# Development without Supabase: the local practice login (never works in production).
LOCAL_LOGIN_EMAIL=demo@north.local
LOCAL_LOGIN_PASSWORD=north-practice
# Pretend payments for development, tests and the attacker: "simulated". Refused in production.
PAYMENTS_MODE=
# Test runs only: multiply the per-person rate limits (ignored in production).
NORTH_DEV_RATE_MULTIPLIER=
# The user's time zone for "late at night" and "this week". Default America/New_York.
DEMO_TIME_ZONE=
# Set to "demo" to use only the 14 curated demo products (no live Channel3 products). Use it when recording the video:
# live products can show real brand names and logos in their pictures, and the contest bans those.
STORE_MODE=
# Lets the scheduled price check (Vercel cron) call GET /api/watch/run with "Authorization: Bearer <this>". Unset = that check is off.
CRON_SECRET=

# Recording the demo: show stores as Store A/B/C, hide product names and blur photos on every screen (real prices stay). Set when building. Also a toggle in Demo tools.
VIDEO_SAFE=
